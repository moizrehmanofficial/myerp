# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3002

# Master Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/myerp_master"

# JWT
JWT_SECRET=myerp_jwt_super_secret_key_change_this_in_production_min_64_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=myerp_refresh_super_secret_key_change_this_in_production_min_64
REFRESH_TOKEN_EXPIRES_IN=7d

# Email (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_email@gmail.com
SMTP_PASS=your_brevo_smtp_key

# Cloudflare R2 (fill later)
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=myerp-files
R2_ENDPOINT=